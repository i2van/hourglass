<Window x:Class="Hourglass.Windows.TimerEventAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Hourglass.Properties"
        Closed="WindowClosed"
        Loaded="WindowLoaded"
        ResizeMode="CanResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Title="{x:Static properties:Resources.TimerEventAppWindowTitle}"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=PathTextBox, Mode=OneWay}">
    <Window.Resources>
        <FontFamily x:Key="LightFontFamily">Segoe UI Light, Segoe UI</FontFamily>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel Name="RootPanel" Width="550">
        <DockPanel Name="MessagePanel" DockPanel.Dock="Top" Background="Gray">
            <Grid DockPanel.Dock="Left"
                  Width="24"
                  Height="24"
                  Margin="15 0 -5 0"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  ToolTip="{x:Static properties:Resources.TimerEventAppWindowDisabledIconToolTip}"
                  Visibility="{Binding ElementName=DisabledCheckBox, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Ellipse Stroke="#FFC83D" StrokeThickness="3"/>
                <Line X1="5.3" Y1="5.3" X2="18.7" Y2="18.7" Stroke="#FFC83D" StrokeThickness="3"/>
            </Grid>
            <TextBlock Name="MessageTextBlock"
                       Focusable="False"
                       TextOptions.TextFormattingMode="Ideal"
                       FontFamily="{StaticResource LightFontFamily}"
                       FontSize="20"
                       Foreground="#F5F5F5"
                       Padding="15 20 80 20"
                       Text="{x:Static properties:Resources.TimerEventAppWindowDefaultMessageText}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F9F9F9" BorderBrush="#DDDDDD" BorderThickness="0 1 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="OkButtonClick"
                        Content="{x:Static properties:Resources.TimerEventAppWindowOkButtonContent}"
                        IsDefault="True"
                        Margin="10 10 0 10"
                        Width="100"
                        Height="25"/>
                <Button Click="CancelButtonClick"
                        Content="{x:Static properties:Resources.TimerEventAppWindowCancelButtonContent}"
                        IsCancel="True"
                        Margin="10"
                        Width="100"
                        Height="25"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="15">
            <Label Content="{x:Static properties:Resources.TimerEventAppWindowPathLabel}"
                   Target="{Binding ElementName=PathTextBox, Mode=OneWay}"
                   Padding="0 0 0 5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="PathTextBox"
                         Height="25"
                         VerticalContentAlignment="Center"
                         TextChanged="PathTextBoxTextChanged"/>
                <Button Grid.Column="1"
                        Click="BrowseButtonClick"
                        Content="{x:Static properties:Resources.TimerEventAppWindowBrowseButtonContent}"
                        Margin="10 0 0 0"
                        Width="100"
                        Height="25"/>
            </Grid>
            <CheckBox Name="DisabledCheckBox"
                      Content="{x:Static properties:Resources.TimerEventAppWindowDisabledCheckBoxContent}"
                      Margin="0 10 0 0"/>
            <CheckBox Name="SilentCheckBox"
                      Content="{x:Static properties:Resources.TimerEventAppWindowSilentCheckBoxContent}"
                      Margin="0 5 0 0"/>
            <TextBlock Foreground="Gray"
                       Margin="0 10 0 0"
                       Text="{x:Static properties:Resources.TimerEventAppWindowHintText}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
